# The Xcode project is generated from project.yml by XcodeGen. Committing a
# pbxproj is how iOS repos acquire merge conflicts nobody can read.
*.xcodeproj
*.xcworkspace
build/
build-release/
.build/
DerivedData/
screenshots/
.DS_Store
xcuserdata/
App/Resources/Info.generated.plist

# Optional local map-key configuration (never commit provider credentials).
*.local.xcconfig

# Python helpers for simulator routes.
__pycache__/
